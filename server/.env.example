# KrishiSeva Smart Farming Assistant — Server Environment Variables
# Copy this file to .env and fill in your real values

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# Get your connection string from: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/krishi_seva?retryWrites=true&w=majority

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Use a strong, random 64+ character secret in production
JWT_SECRET=krishi_seva_smart_farming_jwt_secret_key_2026_replace_in_production
JWT_EXPIRES_IN=7d

# ─── Google Gemini AI (Optional) ─────────────────────────────────────────────
# Get your API key from: https://makersuite.google.com/app/apikey
# Without this key, the system uses the built-in offline knowledge base
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Client URL (for CORS) ────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000

# ─── Email (Future: for Reset Password emails) ────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password
